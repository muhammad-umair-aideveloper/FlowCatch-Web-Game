---
/**
 * index.astro
 * Filterable hub homepage — lists all subject packs with subject filter chips.
 * Full JSON-LD SoftwareApplication + ItemList structured data.
 */
import type { TaxonomyPack } from '../types/game.ts';
import AdSlot from '../components/ads/AdSlot.astro';
import allPacks from '../data/taxonomyPacks.json';

const packs = allPacks as TaxonomyPack[];
const siteUrl = 'https://flowcatch-game.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'FlowCatch — The Conveyor Belt Sorter',
      description: 'Free educational conveyor belt sorting games for students in Grades 3–10 covering English Grammar, Science, Civics, and Chemistry.',
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/#games`,
      name: 'Educational Sorting Games',
      itemListElement: packs.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${siteUrl}/play/${p.slug}`,
        name: p.seoTitle,
      })),
    },
  ],
};

const subjects = [...new Set(packs.map(p => p.subjectCategory))];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free Educational Sorting Games — The Conveyor Belt Sorter | FlowCatch</title>
    <meta name="description" content="Play free conveyor belt sorting games for Grades 3–10! Sort nouns/verbs, solids/liquids/gases, government types, and chemical compounds. Curriculum-aligned, no signup needed." />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content="Free Educational Sorting Games — FlowCatch" />
    <meta property="og:description" content="Play free curriculum-aligned conveyor belt sorting games. English Grammar, Science, Civics, and Chemistry." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-factory-950 text-slate-200 font-sans antialiased min-h-screen">
    <style>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
      html { overflow-x: hidden; }
    </style>

    <!-- Top ad -->
    <div class="hidden md:flex justify-center py-2 bg-factory-900 border-b border-factory-800">
      <AdSlot variant="leaderboard" id="home-top" />
    </div>

    <!-- Header -->
    <header class="bg-factory-900 border-b border-factory-800 px-4 py-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-1">
          <span class="text-3xl" aria-hidden="true">🏭</span>
          <h1 class="text-2xl font-bold text-white">FlowCatch</h1>
        </div>
        <p class="text-factory-400 text-sm">Free educational conveyor belt sorting games — no signup, works on any device</p>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">

      <!-- Hero copy -->
      <section class="text-center mb-10" aria-labelledby="hero-heading">
        <h2 id="hero-heading" class="text-3xl sm:text-4xl font-bold text-white mb-3 leading-tight">
          The Conveyor Belt Sorter
        </h2>
        <p class="text-slate-400 max-w-xl mx-auto text-base leading-relaxed">
          Drag and sort items on an animated factory conveyor belt to master English Grammar, States of Matter, Government Systems, and Chemistry — aligned to Common Core and NGSS standards.
        </p>
      </section>

      <!-- Subject filter chips -->
      <div
        class="flex flex-wrap gap-2 justify-center mb-6"
        role="group"
        aria-label="Filter by subject"
        id="subject-filters"
      >
        <button
          data-filter="all"
          class="filter-chip active text-xs px-4 py-1.5 rounded-full border transition-colors
                 bg-arcade-cyan text-factory-950 border-arcade-cyan font-semibold"
          aria-pressed="true"
        >
          All Subjects
        </button>
        {subjects.map(subj => (
          <button
            data-filter={subj}
            class="filter-chip text-xs px-4 py-1.5 rounded-full border transition-colors
                   bg-factory-800 text-slate-300 border-factory-700
                   hover:bg-factory-700 hover:text-white"
            aria-pressed="false"
          >
            {subj}
          </button>
        ))}
      </div>

      <!-- Pack grid -->
      <div
        id="pack-grid"
        class="grid sm:grid-cols-2 gap-4"
        role="list"
        aria-label="Available sorting games"
      >
        {packs.map((pack) => (
          <article
            class="pack-card bg-factory-900 border border-factory-700 rounded-2xl p-5
                   hover:border-arcade-cyan/60 transition-all duration-200
                   hover:shadow-lg hover:shadow-arcade-cyan/10 group"
            data-subject={pack.subjectCategory}
            role="listitem"
          >
            <!-- Bins preview pills -->
            <div class="flex flex-wrap gap-1.5 mb-3" aria-hidden="true">
              {pack.bins.map(bin => (
                <span
                  class={`text-xs px-2 py-0.5 rounded-full font-mono ${bin.colorTheme.pillBg} ${bin.colorTheme.text}`}
                >
                  {bin.icon} {bin.label}
                </span>
              ))}
            </div>

            <h3 class="text-base font-bold text-white mb-1 leading-snug group-hover:text-arcade-cyan transition-colors">
              {pack.h1Heading}
            </h3>

            <div class="flex items-center gap-3 text-xs text-factory-400 mb-3">
              <span>{pack.gradeLevel}</span>
              <span aria-hidden="true">·</span>
              <span>⏱ ~{pack.estimatedPlayTimeMinutes} min</span>
              <span aria-hidden="true">·</span>
              <span>{pack.items.length} items</span>
            </div>

            <p class="text-slate-400 text-xs leading-relaxed mb-4 line-clamp-2">
              {pack.seoGuideContent.overview.slice(0, 120)}…
            </p>

            <a
              href={`/play/${pack.slug}`}
              class="inline-flex items-center gap-2 text-sm font-semibold
                     text-arcade-cyan hover:text-white transition-colors"
              aria-label={`Play ${pack.h1Heading}`}
            >
              Play Now →
            </a>
          </article>
        ))}
      </div>

      <!-- Bottom ad -->
      <div class="hidden md:flex justify-center mt-12">
        <AdSlot variant="leaderboard" id="home-bottom" />
      </div>
      <div class="flex md:hidden justify-center mt-8">
        <AdSlot variant="rectangle" id="home-bottom-mobile" />
      </div>

      <!-- Below-fold SEO copy -->
      <section class="mt-14 prose prose-invert prose-sm max-w-none" aria-labelledby="about-heading">
        <h2 id="about-heading" class="text-xl font-bold text-white mb-3">About The Conveyor Belt Sorter</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-3">
          FlowCatch's Conveyor Belt Sorter is a free, curriculum-aligned educational game platform that makes classifying academic concepts fast, engaging, and memorable. Students drag word crates, substance crates, and formula crates along an animated factory conveyor belt into the correct category bin — before they reach the incinerator.
        </p>
        <p class="text-slate-400 text-sm leading-relaxed mb-3">
          Each subject pack includes 25+ items with micro-explanations on every sort, three progressive difficulty waves, and a full Teacher &amp; Student Curriculum Guide below each game. Games run directly in the browser with no downloads, no logins, and no installs — compatible with Chromebooks, tablets, and desktops.
        </p>
        <h3 class="text-base font-semibold text-white mt-6 mb-2">Curriculum Standards Covered</h3>
        <ul class="text-slate-400 text-sm space-y-1 list-disc list-inside">
          <li>CCSS.ELA-LITERACY.L.3.1 — Parts of Speech (Nouns, Verbs, Adjectives)</li>
          <li>NGSS PS1.A — Structure and Properties of Matter (Solids, Liquids, Gases)</li>
          <li>NCSS Theme VI — Power, Authority, and Governance (Democracy, Monarchy, Dictatorship)</li>
          <li>NGSS PS1.B — Chemical Reactions (Acids, Bases, and Neutral Salts)</li>
        </ul>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-factory-900 border-t border-factory-800 mt-16 py-8 px-4 text-center text-factory-500 text-xs">
      <p>&copy; {new Date().getFullYear()} FlowCatch — Free Educational Games</p>
    </footer>

    <!-- Subject filter JS -->
    <script>
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
      const cards = document.querySelectorAll<HTMLElement>('.pack-card');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter!;

          filterBtns.forEach(b => {
            b.classList.remove('active', 'bg-arcade-cyan', 'text-factory-950', 'border-arcade-cyan', 'font-semibold');
            b.classList.add('bg-factory-800', 'text-slate-300', 'border-factory-700');
            b.setAttribute('aria-pressed', 'false');
          });

          btn.classList.add('active', 'bg-arcade-cyan', 'text-factory-950', 'border-arcade-cyan', 'font-semibold');
          btn.classList.remove('bg-factory-800', 'text-slate-300', 'border-factory-700');
          btn.setAttribute('aria-pressed', 'true');

          cards.forEach((card) => {
            const show = filter === 'all' || card.dataset.subject === filter;
            card.style.display = show ? '' : 'none';
          });
        });
      });
    </script>
  </body>
</html>
