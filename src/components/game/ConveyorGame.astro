---
/**
 * ConveyorGame.astro
 * Main game component — renders the canvas, HUD, bins, and modals.
 * Bootstraps the game engine and wires up all UI feedback.
 * Styled with the high-energy "Toybox Factory" design system.
 */
import type { TaxonomyPack } from '../../types/game.ts';

interface Props {
  pack: TaxonomyPack;
}

const { pack } = Astro.props;
const packJson = JSON.stringify(pack);
---

<section
  class="game-wrapper relative w-full max-w-4xl mx-auto select-none bg-white p-3 sm:p-4 rounded-3xl border-4 border-slate-700 shadow-toy-lg"
  aria-label={`${pack.h1Heading} — Interactive Game`}
  data-pack={packJson}
>
  <!-- ── Playful Factory HUD ──────────────────────────────────────────────── -->
  <div
    id="game-hud"
    class="flex items-center justify-between px-4 py-2.5 bg-slate-800 text-white rounded-2xl border-b-4 border-slate-950 shadow-sm"
  >
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Lives / Hearts -->
      <div
        class="flex items-center gap-1 bg-slate-900/90 px-3 py-1 rounded-xl border border-slate-700 shadow-inner"
        aria-label="Lives remaining"
        id="lives-display"
      >
        <span class="text-lg filter drop-shadow" title="Life">❤️</span>
        <span class="text-lg filter drop-shadow" title="Life">❤️</span>
        <span class="text-lg filter drop-shadow" title="Life">❤️</span>
      </div>
      <!-- Shift badge -->
      <span
        id="shift-badge"
        class="text-xs font-black bg-yellow-400 text-slate-950 border-b-4 border-yellow-600 px-3 py-1 rounded-xl shadow-sm uppercase tracking-wider"
      >
        Shift 1
      </span>
    </div>

    <div class="flex items-center gap-4 sm:gap-6">
      <!-- Streak -->
      <div class="text-right">
        <p class="text-[10px] text-yellow-300 font-extrabold uppercase tracking-wider">Streak</p>
        <p id="streak-display" class="text-yellow-400 font-black text-base sm:text-lg leading-tight font-display">0</p>
      </div>
      <!-- Score -->
      <div class="text-right">
        <p class="text-[10px] text-emerald-300 font-extrabold uppercase tracking-wider">Score</p>
        <p id="score-display" class="text-emerald-400 font-black text-xl sm:text-2xl leading-tight font-display">0</p>
      </div>
    </div>
  </div>

  <!-- ── Conveyor Arena Canvas ───────────────────────────────────────────── -->
  <div class="relative bg-slate-900 rounded-2xl overflow-hidden border-4 border-slate-800 my-3 shadow-inner">
    <canvas
      id="game-canvas"
      class="w-full block touch-none"
      width="800"
      height="320"
      aria-label="Conveyor belt game area — drag items to the correct bins below"
    ></canvas>
  </div>

  <!-- ── 3D Toybox Sorting Buckets ────────────────────────────────────────── -->
  <div
    id="bins-row"
    class="grid gap-2.5 sm:gap-3 p-1"
    style={`grid-template-columns: repeat(${pack.bins.length}, 1fr);`}
    role="group"
    aria-label="Sorting bins — drop items here"
  >
    {pack.bins.map((bin) => (
      <button
        class={[
          'bin-target relative flex flex-col items-center justify-center gap-1',
          'min-h-[96px] rounded-2xl border-4 transition-all duration-100 cursor-pointer',
          'shadow-toy-md hover:brightness-105 active:translate-y-1 active:shadow-none p-2',
          'focus-visible:ring-4 focus-visible:ring-sky-400 focus-visible:outline-none',
          bin.colorTheme.bg,
          bin.colorTheme.border,
          bin.colorTheme.text,
        ].join(' ')}
        data-bin-id={bin.id}
        aria-label={`Sort into ${bin.label} bin — ${bin.shortRuleHint}`}
        title={bin.shortRuleHint}
        type="button"
      >
        <span class="text-3xl filter drop-shadow pointer-events-none" aria-hidden="true">{bin.icon}</span>
        <span class="text-sm sm:text-base font-black tracking-wide pointer-events-none font-display">{bin.label}</span>
        <span class="text-[11px] font-bold opacity-75 text-center px-1 pointer-events-none leading-tight max-w-[140px]">
          {bin.shortRuleHint}
        </span>
        <!-- Drop highlight overlay -->
        <span
          class={[
            'bin-glow absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-150',
            'pointer-events-none border-4 border-dashed',
            bin.colorTheme.border,
          ].join(' ')}
          aria-hidden="true"
        ></span>
      </button>
    ))}
  </div>

  <!-- ── Toast / Correction notification ─────────────────────────────────── -->
  <div
    id="correction-toast"
    class="hidden absolute bottom-32 left-1/2 -translate-x-1/2 z-20
           max-w-sm w-[90%] bg-white border-4 border-red-500 rounded-2xl
           px-4 py-3 shadow-toy-lg text-sm text-slate-900 text-center font-bold"
    role="alert"
    aria-live="assertive"
  >
    <p id="toast-text" class="leading-snug"></p>
  </div>

  <!-- ── Shift-break modal ─────────────────────────────────────────────────── -->
  <div
    id="shift-modal"
    class="hidden absolute inset-0 z-30 flex items-center justify-center
           bg-slate-900/80 backdrop-blur-sm rounded-3xl p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="shift-modal-title"
  >
    <div class="bg-white border-4 border-slate-700 rounded-3xl p-6 sm:p-8 max-w-sm w-full text-center shadow-toy-lg">
      <div class="text-5xl mb-2 filter drop-shadow animate-bounce-subtle" aria-hidden="true">🏭</div>
      <h2 id="shift-modal-title" class="text-2xl font-black text-slate-900 mb-1 font-display">Shift Complete!</h2>
      <p class="text-xs text-slate-500 font-bold mb-3 uppercase tracking-wider">Factory Inspection Report</p>
      <div id="shift-stats" class="bg-sky-50 border-2 border-sky-200 rounded-2xl p-3 text-slate-800 text-sm font-bold space-y-1 mb-4 text-left"></div>
      <!-- Ad slot inside modal break -->
      <div class="ad-break-slot my-3 mx-auto w-full max-w-[300px] h-[100px]
                  bg-slate-100 border-2 border-dashed border-slate-300 rounded-xl
                  flex items-center justify-center text-slate-400 text-xs font-bold"
        aria-hidden="true"
      >
        <span>📢 Advertisement Break</span>
      </div>
      <button
        id="next-shift-btn"
        class="btn-3d w-full py-3.5 rounded-2xl bg-sky-500 hover:bg-sky-400 text-white font-black text-lg
               border-b-4 border-sky-700 shadow-toy-md active:translate-y-1 active:border-b-0 transition-colors"
        type="button"
      >
        Start Next Shift 🚀
      </button>
    </div>
  </div>

  <!-- ── Game-over modal ───────────────────────────────────────────────────── -->
  <div
    id="gameover-modal"
    class="hidden absolute inset-0 z-30 flex items-center justify-center
           bg-slate-900/80 backdrop-blur-sm rounded-3xl p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="gameover-title"
  >
    <div class="bg-white border-4 border-slate-700 rounded-3xl p-6 sm:p-8 max-w-sm w-full text-center shadow-toy-lg">
      <div class="text-5xl mb-2 filter drop-shadow" aria-hidden="true">🎓</div>
      <h2 id="gameover-title" class="text-2xl font-black text-slate-900 mb-1 font-display">Session Complete!</h2>
      <p class="text-xs text-slate-500 font-bold mb-3 uppercase tracking-wider">Final Graduation Report</p>
      <div id="gameover-stats" class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-3 text-slate-800 text-sm font-bold space-y-1 mb-5 text-left"></div>
      <button
        id="play-again-btn"
        class="btn-3d w-full py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-white font-black text-lg
               border-b-4 border-emerald-700 shadow-toy-md active:translate-y-1 active:border-b-0 transition-colors"
        type="button"
      >
        Play Again 🔄
      </button>
    </div>
  </div>

  <!-- ── Start overlay ────────────────────────────────────────────────────── -->
  <div
    id="start-overlay"
    class="absolute inset-0 z-30 flex items-center justify-center
           bg-slate-900/75 backdrop-blur-sm rounded-3xl p-4"
  >
    <div class="bg-white border-4 border-slate-700 rounded-3xl p-6 sm:p-8 max-w-md w-full text-center shadow-toy-lg">
      <div class="text-6xl mb-3 filter drop-shadow animate-bounce-subtle" aria-hidden="true">🏭</div>
      <h2 class="text-3xl font-black text-slate-900 mb-2 font-display">Ready to Sort?</h2>
      <p class="text-slate-600 text-sm font-semibold mb-6 max-w-xs mx-auto leading-relaxed">
        Drag items from the conveyor belt into the correct bucket before they reach the furnace!
      </p>
      <button
        id="start-btn"
        class="btn-3d w-full py-4 rounded-2xl bg-sky-500 hover:bg-sky-400 text-white font-black text-xl
               border-b-4 border-sky-700 shadow-toy-md active:translate-y-1 active:border-b-0 transition-all"
        type="button"
      >
        Start Shift 1 🚀
      </button>
    </div>
  </div>
</section>

<script>
  import { ConveyorGameEngine } from '../../scripts/gameEngine.js';
  import { initAdController, triggerShiftBreakAd, refreshBannerSlot, pingEngagement } from '../../scripts/adController.js';
  import { resumeAudio } from '../../scripts/soundEngine.js';
  import type { TaxonomyPack, BinRect } from '../../types/game.js';

  // ── Bootstrap ────────────────────────────────────────────────────────────────
  const wrapper = document.querySelector<HTMLElement>('.game-wrapper')!;
  const pack: TaxonomyPack = JSON.parse(wrapper.dataset.pack!);

  const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
  const scoreEl = document.getElementById('score-display')!;
  const streakEl = document.getElementById('streak-display')!;
  const shiftBadge = document.getElementById('shift-badge')!;
  const livesEl = document.getElementById('lives-display')!;
  const toastEl = document.getElementById('correction-toast')!;
  const toastText = document.getElementById('toast-text')!;
  const shiftModal = document.getElementById('shift-modal')!;
  const shiftStats = document.getElementById('shift-stats')!;
  const nextShiftBtn = document.getElementById('next-shift-btn')!;
  const gameoverModal = document.getElementById('gameover-modal')!;
  const gameoverStats = document.getElementById('gameover-stats')!;
  const playAgainBtn = document.getElementById('play-again-btn')!;
  const startOverlay = document.getElementById('start-overlay')!;
  const startBtn = document.getElementById('start-btn')!;

  initAdController();

  // Resume Web Audio on first user gesture
  window.addEventListener('pointerdown', () => resumeAudio(), { passive: true });

  // ── Measure bin rects in canvas-space ────────────────────────────────────────
  function measureBinRects(): BinRect[] {
    const canvasRect = canvas.getBoundingClientRect();
    if (!canvasRect.width || !canvasRect.height) return [];

    const scaleX = canvas.width / canvasRect.width;
    const scaleY = canvas.height / canvasRect.height;

    return Array.from(document.querySelectorAll<HTMLElement>('[data-bin-id]')).map((el) => {
      const r = el.getBoundingClientRect();
      return {
        id: el.dataset.binId!,
        x: (r.left - canvasRect.left) * scaleX,
        y: (r.top - canvasRect.top) * scaleY,
        width: r.width * scaleX,
        height: r.height * scaleY,
      };
    });
  }

  // ── Engine ───────────────────────────────────────────────────────────────────
  let engine = new ConveyorGameEngine(canvas, pack);

  function setupEngine() {
    engine.setBinRects(measureBinRects());
    engine.setBinRectsProvider(measureBinRects);

    engine.on((event) => {
      switch (event.type) {
        case 'score_update':
          scoreEl.textContent = event.score.toLocaleString();
          streakEl.textContent = String(event.streak);
          pingEngagement();
          break;

        case 'life_lost':
          renderLives(event.lives);
          pingEngagement();
          break;

        case 'item_sorted':
          showToast(event.correct, event.itemLabel, event.explanation);
          break;

        case 'shift_complete':
          const p = event.performance;
          shiftStats.innerHTML = `
            <p>✅ Correct: <strong>${p.sortedCorrectly}</strong> / ${p.totalItems}</p>
            <p>🎯 Accuracy: <strong>${p.accuracy}%</strong></p>
            <p>🔥 Max streak: <strong>${p.maxStreak}</strong></p>
            <p>⭐ Points: <strong>${p.pointsEarned.toLocaleString()}</strong></p>
          `;
          shiftModal.classList.remove('hidden');
          triggerShiftBreakAd({
            onBeforeAd: () => { /* game already paused */ },
            onAfterAd: () => refreshBannerSlot('shift-break-300x250'),
          });
          refreshBannerSlot('top-leaderboard');
          break;

        case 'game_over':
          showGameOver(event.history);
          break;
      }
    });
  }

  // ── Helpers ──────────────────────────────────────────────────────────────────
  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  function showToast(correct: boolean, label: string, explanation: string) {
    if (correct) return; // only show on wrong sorts
    toastText.textContent = `❌ "${label}" → ${explanation}`;
    toastEl.classList.remove('hidden');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.add('hidden'), 3500);
  }

  function renderLives(lives: number) {
    const hearts = ['❤️', '❤️', '❤️'].map((h, i) => i < lives ? h : '🖤').join('');
    livesEl.textContent = hearts;
  }

  function showGameOver(history: any[]) {
    let totalCorrect = 0, totalItems = 0, totalPts = 0, maxStrk = 0;
    history.forEach(h => {
      totalCorrect += h.sortedCorrectly;
      totalItems += h.totalItems;
      totalPts += h.pointsEarned;
      maxStrk = Math.max(maxStrk, h.maxStreak);
    });
    const acc = totalItems > 0 ? Math.round((totalCorrect / totalItems) * 100) : 0;
    gameoverStats.innerHTML = `
      <p>📦 Items sorted: <strong>${totalItems}</strong></p>
      <p>🎯 Accuracy: <strong>${acc}%</strong></p>
      <p>🔥 Best streak: <strong>${maxStrk}</strong></p>
      <p>⭐ Total score: <strong>${totalPts.toLocaleString()}</strong></p>
    `;
    gameoverModal.classList.remove('hidden');
  }

  // ── Button handlers ──────────────────────────────────────────────────────────
  startBtn.addEventListener('click', () => {
    resumeAudio();
    startOverlay.classList.add('hidden');
    setupEngine();
    engine.start();
  });

  nextShiftBtn.addEventListener('click', () => {
    resumeAudio();
    shiftModal.classList.add('hidden');
    const s = engine.getState();
    shiftBadge.textContent = `Shift ${Math.min((s.currentShift as number) + 1, 3)}`;
    engine.resumeAfterBreak();
  });

  playAgainBtn.addEventListener('click', () => {
    resumeAudio();
    gameoverModal.classList.add('hidden');
    engine.stop();
    engine = new ConveyorGameEngine(canvas, pack);
    livesEl.innerHTML = '❤️❤️❤️';
    scoreEl.textContent = '0';
    streakEl.textContent = '0';
    shiftBadge.textContent = 'Shift 1';
    setupEngine();
    engine.start();
  });

  // Bin click-to-sort (accessibility & tap mode)
  document.querySelectorAll<HTMLElement>('[data-bin-id]').forEach((binEl) => {
    binEl.addEventListener('click', () => {
      resumeAudio();
      engine.sortSelectedItem(binEl.dataset.binId!);
    });
  });

  // Dynamic bin rect updates on resize and scroll
  window.addEventListener('resize', () => engine.setBinRects(measureBinRects()), { passive: true });
  window.addEventListener('scroll', () => engine.setBinRects(measureBinRects()), { passive: true });
</script>
