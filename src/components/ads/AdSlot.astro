---
/**
 * AdSlot.astro
 * Zero-CLS pre-sized ad containers with safety buffer around game bins.
 * Pre-sizes every slot in CSS before the ad script loads to prevent layout shift.
 *
 * Usage:
 *   <AdSlot variant="leaderboard" id="top-ad" />
 *   <AdSlot variant="mobile-banner" id="bottom-sticky" />
 *   <AdSlot variant="rectangle" id="sidebar-ad" />
 */

export type AdVariant = 'leaderboard' | 'mobile-banner' | 'rectangle';

interface Props {
  variant: AdVariant;
  id: string;
  label?: string;
  class?: string;
}

const { variant, id, label = 'Advertisement', class: className = '' } = Astro.props;

// ── Pre-sized dimensions (prevents CLS score = 0) ──────────────────────────
const dimensions: Record<AdVariant, { w: number; h: number; cssW: string; cssH: string; desc: string }> = {
  leaderboard: {
    w: 728, h: 90,
    cssW: 'w-full max-w-[728px]',
    cssH: 'h-[90px]',
    desc: '728×90 desktop leaderboard',
  },
  'mobile-banner': {
    w: 320, h: 50,
    cssW: 'w-full max-w-[320px]',
    cssH: 'h-[50px]',
    desc: '320×50 mobile sticky banner',
  },
  rectangle: {
    w: 300, h: 250,
    cssW: 'w-full max-w-[300px]',
    cssH: 'h-[250px]',
    desc: '300×250 medium rectangle',
  },
};

const dim = dimensions[variant];
---

<!--
  Slot wrapper: pre-sized via CSS to avoid CLS.
  The inner div matches the ad unit dimensions exactly.
  32px safety padding added via containing section on /play pages.
-->
<div
  id={`ad-slot-${id}`}
  class={[
    'ad-slot',
    'flex items-center justify-center overflow-hidden',
    'bg-factory-900 border border-factory-700/50',
    dim.cssW,
    dim.cssH,
    className,
  ].join(' ')}
  data-variant={variant}
  data-slot-id={id}
  aria-label={label}
  role="complementary"
>
  <!-- Content placeholder — replaced by ad script at runtime -->
  <span class="text-factory-500 text-xs select-none pointer-events-none" aria-hidden="true">
    {label}
  </span>
</div>

<style>
  /* Explicit width/height in CSS to guarantee CLS = 0 even before JS loads */
  .ad-slot[data-variant="leaderboard"]    { min-height: 90px; }
  .ad-slot[data-variant="mobile-banner"]  { min-height: 50px; }
  .ad-slot[data-variant="rectangle"]     { min-height: 250px; }
</style>
