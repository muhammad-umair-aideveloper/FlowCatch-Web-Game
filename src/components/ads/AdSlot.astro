---
/**
 * AdSlot.astro
 * Zero-CLS pre-sized ad containers styled as clean toybox billboard frames.
 * Pre-sizes every slot in CSS before the ad script loads to prevent layout shift.
 *
 * Usage:
 *   <AdSlot variant="leaderboard" id="top-ad" />
 *   <AdSlot variant="mobile-banner" id="bottom-sticky" />
 *   <AdSlot variant="rectangle" id="sidebar-ad" />
 */

export type AdVariant = 'leaderboard' | 'mobile-banner' | 'rectangle';

interface Props {
  variant: AdVariant;
  id: string;
  label?: string;
  class?: string;
}

const { variant, id, label = 'Advertisement', class: className = '' } = Astro.props;

// ── Pre-sized dimensions (prevents CLS score = 0) ──────────────────────────
const dimensions: Record<AdVariant, { w: number; h: number; cssW: string; cssH: string; desc: string }> = {
  leaderboard: {
    w: 728, h: 90,
    cssW: 'w-full max-w-[728px]',
    cssH: 'h-[90px]',
    desc: '728×90 desktop leaderboard',
  },
  'mobile-banner': {
    w: 320, h: 50,
    cssW: 'w-full max-w-[320px]',
    cssH: 'h-[50px]',
    desc: '320×50 mobile sticky banner',
  },
  rectangle: {
    w: 300, h: 250,
    cssW: 'w-full max-w-[300px]',
    cssH: 'h-[250px]',
    desc: '300×250 medium rectangle',
  },
};

const dim = dimensions[variant];
---

<div
  id={`ad-slot-${id}`}
  class={[
    'ad-slot',
    'flex items-center justify-center overflow-hidden',
    'bg-white/90 border-2 border-dashed border-sky-300 rounded-2xl shadow-sm',
    dim.cssW,
    dim.cssH,
    className,
  ].join(' ')}
  data-variant={variant}
  data-slot-id={id}
  aria-label={label}
  role="complementary"
>
  <span class="text-sky-600/70 font-semibold text-xs select-none pointer-events-none tracking-wider uppercase flex items-center gap-1.5" aria-hidden="true">
    <span>📢</span>
    <span>{label}</span>
  </span>
</div>

<style>
  /* Strict pre-sized dimensions to guarantee CLS = 0 */
  .ad-slot[data-variant="leaderboard"] {
    min-width: min(100%, 728px);
    min-height: 90px;
    height: 90px;
  }
  .ad-slot[data-variant="mobile-banner"] {
    min-width: min(100%, 320px);
    min-height: 50px;
    height: 50px;
  }
  .ad-slot[data-variant="rectangle"] {
    min-width: 300px;
    min-height: 250px;
    width: 300px;
    height: 250px;
  }
</style>
