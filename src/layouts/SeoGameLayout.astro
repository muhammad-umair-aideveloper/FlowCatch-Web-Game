---
/**
 * SeoGameLayout.astro
 * Shared layout: injects keyword-optimized meta, JSON-LD structured data,
 * and a sticky mobile banner with 32px safety margin above the game bins.
 */
import type { TaxonomyPack } from '../types/game.ts';
import AdSlot from '../components/ads/AdSlot.astro';

interface Props {
  pack: TaxonomyPack;
  canonicalUrl: string;
}

const { pack, canonicalUrl } = Astro.props;

// ── JSON-LD graph ─────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonicalUrl}#app`,
      name: pack.seoTitle,
      url: canonicalUrl,
      applicationCategory: 'GameApplication',
      applicationSubCategory: 'EducationalGame',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description: pack.metaDescription,
      educationalLevel: pack.gradeLevel,
      about: {
        '@type': 'Thing',
        name: pack.subjectCategory,
      },
    },
    {
      '@type': 'LearningResource',
      '@id': `${canonicalUrl}#learning`,
      name: pack.h1Heading,
      url: canonicalUrl,
      educationalLevel: pack.gradeLevel,
      learningResourceType: 'Interactive Game',
      educationalAlignment: {
        '@type': 'AlignmentObject',
        alignmentType: 'educationalFramework',
        educationalFramework: pack.curriculumStandard,
        targetName: pack.curriculumStandard,
      },
      teaches: pack.seoGuideContent.pedagogicalObjectives.join('; '),
      timeRequired: `PT${pack.estimatedPlayTimeMinutes}M`,
      isAccessibleForFree: true,
      inLanguage: 'en-US',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://flowcatch-game.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pack.subjectCategory,
          item: `https://flowcatch-game.com/play/${pack.slug}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: pack.seoTitle,
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: pack.seoGuideContent.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pack.seoTitle}</title>
    <meta name="description" content={pack.metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pack.seoTitle} />
    <meta property="og:description" content={pack.metaDescription} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pack.seoTitle} />
    <meta name="twitter:description" content={pack.metaDescription} />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Global fonts preconnect (no FOUT) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-factory-950 text-slate-200 min-h-screen font-sans antialiased">
    <!-- ── Skip link (a11y) ──────────────────────────────────────────────── -->
    <a
      href="#game-section"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4
             focus:z-50 focus:bg-arcade-cyan focus:text-factory-950
             focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold"
    >
      Skip to game
    </a>

    <!-- ── Top Leaderboard Ad (desktop) — pre-sized 728×90 ─────────────── -->
    <div class="hidden md:flex justify-center py-2 bg-factory-900 border-b border-factory-800">
      <AdSlot variant="leaderboard" id="top-leaderboard" />
    </div>

    <!-- ── Site header ──────────────────────────────────────────────────── -->
    <header class="bg-factory-900 border-b border-factory-800 px-4 py-3">
      <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
        <a href="/" class="text-arcade-cyan font-bold text-lg hover:text-sky-300 transition-colors">
          🏭 FlowCatch
        </a>
        <nav aria-label="Subject packs">
          <ul class="flex flex-wrap gap-2 text-xs">
            <li>
              <a href="/play/noun-verb-adjective-sorting-game"
                class="text-slate-400 hover:text-white transition-colors px-2 py-1 rounded hover:bg-factory-800">
                English
              </a>
            </li>
            <li>
              <a href="/play/solid-liquid-gas-states-of-matter-game"
                class="text-slate-400 hover:text-white transition-colors px-2 py-1 rounded hover:bg-factory-800">
                Science
              </a>
            </li>
            <li>
              <a href="/play/democracy-monarchy-dictatorship-civics-game"
                class="text-slate-400 hover:text-white transition-colors px-2 py-1 rounded hover:bg-factory-800">
                Civics
              </a>
            </li>
            <li>
              <a href="/play/acids-bases-salts-chemistry-sorting-game"
                class="text-slate-400 hover:text-white transition-colors px-2 py-1 rounded hover:bg-factory-800">
                Chemistry
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- ── Main ─────────────────────────────────────────────────────────── -->
    <main id="main-content">
      <slot />
    </main>

    <!-- ── Footer ───────────────────────────────────────────────────────── -->
    <footer class="bg-factory-900 border-t border-factory-800 mt-16 py-8 px-4 text-center text-factory-500 text-xs">
      <p class="mb-1">
        &copy; {new Date().getFullYear()} FlowCatch — Free Educational Games
      </p>
      <p>
        <a href="/" class="hover:text-white transition-colors">Home</a>
        {' · '}
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        {' · '}
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </p>
    </footer>

    <!-- ── Mobile Sticky Bottom Banner (32px safety buffer above game bins) -->
    <div
      id="mobile-sticky-ad"
      class="md:hidden fixed bottom-0 left-0 right-0 z-40
             flex justify-center py-1 bg-factory-900 border-t border-factory-800"
      style="padding-bottom: env(safe-area-inset-bottom, 0px);"
    >
      <AdSlot variant="mobile-banner" id="bottom-sticky" />
    </div>
    <!-- 32px spacer so game bins never sit behind the sticky ad -->
    <div class="md:hidden h-[82px]" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  /* Smooth focus rings site-wide */
  :focus-visible {
    outline: 2px solid #06b6d4;
    outline-offset: 2px;
  }

  /* Prevent horizontal overflow from ads */
  html, body {
    overflow-x: hidden;
  }
</style>
