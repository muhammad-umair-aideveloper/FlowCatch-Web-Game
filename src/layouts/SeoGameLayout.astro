---
/**
 * SeoGameLayout.astro
 * Shared layout: injects keyword-optimized meta, JSON-LD structured data,
 * and a sticky mobile banner with 32px safety margin above the game bins.
 * Styled with the bright "Toybox Factory" design system.
 */
import type { TaxonomyPack } from '../types/game.ts';
import AdSlot from '../components/ads/AdSlot.astro';

interface Props {
  pack: TaxonomyPack;
  canonicalUrl: string;
}

const { pack, canonicalUrl } = Astro.props;

// ── JSON-LD graph (VideoGame, SoftwareApplication, LearningResource, BreadcrumbList, FAQPage) ──
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${canonicalUrl}#game`,
      name: pack.seoTitle,
      url: canonicalUrl,
      description: pack.metaDescription,
      genre: ['Educational', '2D Puzzle', 'Sorting'],
      gamePlatform: ['Web Browser'],
      applicationCategory: 'GameApplication',
      playMode: 'SinglePlayer',
      inLanguage: 'en-US',
      numberOfPlayers: {
        '@type': 'QuantitativeValue',
        value: 1,
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonicalUrl}#app`,
      name: pack.seoTitle,
      url: canonicalUrl,
      applicationCategory: 'GameApplication',
      applicationSubCategory: 'EducationalGame',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description: pack.metaDescription,
      educationalLevel: pack.gradeLevel,
      about: {
        '@type': 'Thing',
        name: pack.subjectCategory,
      },
    },
    {
      '@type': 'LearningResource',
      '@id': `${canonicalUrl}#learning`,
      name: pack.h1Heading,
      url: canonicalUrl,
      educationalLevel: pack.gradeLevel,
      learningResourceType: 'Interactive Game',
      educationalAlignment: {
        '@type': 'AlignmentObject',
        alignmentType: 'educationalFramework',
        educationalFramework: pack.curriculumStandard,
        targetName: pack.curriculumStandard,
      },
      teaches: pack.seoGuideContent.pedagogicalObjectives.join('; '),
      timeRequired: `PT${pack.estimatedPlayTimeMinutes}M`,
      isAccessibleForFree: true,
      inLanguage: 'en-US',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://flowcatch-game.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pack.subjectCategory,
          item: `https://flowcatch-game.com/play/${pack.slug}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: pack.seoTitle,
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: pack.seoGuideContent.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pack.seoTitle}</title>
    <meta name="description" content={pack.metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pack.seoTitle} />
    <meta property="og:description" content={pack.metaDescription} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pack.seoTitle} />
    <meta name="twitter:description" content={pack.metaDescription} />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

    <!-- JSON-LD Structured Data Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Fonts: Fredoka & Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700;800&family=Nunito:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-sky-50 text-slate-900 min-h-screen font-sans antialiased selection:bg-yellow-300 selection:text-slate-900">
    <!-- Skip link (a11y) -->
    <a
      href="#game-section"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4
             focus:z-50 focus:bg-yellow-400 focus:text-slate-900 focus:border-2 focus:border-slate-900
             focus:px-5 focus:py-2.5 focus:rounded-2xl focus:font-black focus:shadow-toy-md"
    >
      Skip to game
    </a>

    <!-- Top Leaderboard Ad (desktop) — pre-sized 728×90 with 32px+ separation -->
    <div class="hidden md:flex justify-center py-3 bg-sky-100/70 border-b border-sky-200">
      <AdSlot variant="leaderboard" id="top-leaderboard" />
    </div>

    <!-- Cheerful Toybox Header -->
    <header class="bg-white/95 backdrop-blur-md border-b-4 border-slate-200 px-4 py-3.5 shadow-sm sticky top-0 z-30">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-3xl filter drop-shadow group-hover:rotate-12 transition-transform duration-200" aria-hidden="true">🏭</span>
          <span class="text-2xl font-black text-sky-600 tracking-tight font-display group-hover:text-sky-500 transition-colors">
            FlowCatch
          </span>
        </a>
        <nav aria-label="Subject packs">
          <ul class="flex flex-wrap gap-2 text-xs font-bold">
            <li>
              <a
                href="/play/noun-verb-adjective-sorting-game"
                class="inline-block bg-sky-100 hover:bg-sky-200 text-sky-800 border-2 border-sky-300 px-3 py-1.5 rounded-xl transition-all shadow-sm active:translate-y-0.5"
              >
                📝 English
              </a>
            </li>
            <li>
              <a
                href="/play/solid-liquid-gas-states-of-matter-game"
                class="inline-block bg-emerald-100 hover:bg-emerald-200 text-emerald-800 border-2 border-emerald-300 px-3 py-1.5 rounded-xl transition-all shadow-sm active:translate-y-0.5"
              >
                🧪 Science
              </a>
            </li>
            <li>
              <a
                href="/play/democracy-monarchy-dictatorship-civics-game"
                class="inline-block bg-purple-100 hover:bg-purple-200 text-purple-800 border-2 border-purple-300 px-3 py-1.5 rounded-xl transition-all shadow-sm active:translate-y-0.5"
              >
                🏛️ Civics
              </a>
            </li>
            <li>
              <a
                href="/play/acids-bases-salts-chemistry-sorting-game"
                class="inline-block bg-amber-100 hover:bg-amber-200 text-amber-800 border-2 border-amber-300 px-3 py-1.5 rounded-xl transition-all shadow-sm active:translate-y-0.5"
              >
                ⚗️ Chemistry
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Playful Toybox Footer -->
    <footer class="bg-white border-t-4 border-slate-200 mt-20 py-10 px-4 text-center text-slate-500 text-sm font-medium">
      <div class="max-w-4xl mx-auto flex flex-col items-center gap-3">
        <div class="flex items-center gap-2 text-lg font-bold text-slate-800">
          <span>🏭 FlowCatch</span>
          <span class="text-slate-300">·</span>
          <span class="text-xs bg-yellow-300 text-yellow-950 font-black px-2.5 py-0.5 rounded-full border border-yellow-400">
            K-8 LEARNING
          </span>
        </div>
        <p class="text-slate-600 text-xs max-w-md">
          Hands-on educational conveyor belt sorting games designed for Chromebooks, tablets, and classroom interactive screens.
        </p>
        <p class="text-xs text-slate-400 pt-2 flex items-center gap-3">
          <a href="/" class="hover:text-sky-600 transition-colors font-semibold">Home</a>
          <span>•</span>
          <a href="/privacy" class="hover:text-sky-600 transition-colors font-semibold">Privacy</a>
          <span>•</span>
          <a href="/contact" class="hover:text-sky-600 transition-colors font-semibold">Contact</a>
        </p>
        <p class="text-[11px] text-slate-400">
          &copy; {new Date().getFullYear()} FlowCatch — Free Educational Games for Classrooms & Students
        </p>
      </div>
    </footer>

    <!-- Mobile Sticky Bottom Banner (strictly 32px safety clearance above game bins) -->
    <div
      id="mobile-sticky-ad"
      class="md:hidden fixed bottom-0 left-0 right-0 z-40
             flex justify-center py-1.5 bg-white/95 backdrop-blur-md border-t-2 border-slate-200 shadow-md"
      style="padding-bottom: env(safe-area-inset-bottom, 0px);"
    >
      <AdSlot variant="mobile-banner" id="bottom-sticky" />
    </div>
    <!-- 82px spacer (50px banner + 32px safety clearance buffer) -->
    <div class="md:hidden h-[82px]" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  :focus-visible {
    outline: 3px solid #0284c7;
    outline-offset: 3px;
  }

  html, body {
    overflow-x: hidden;
  }
</style>
